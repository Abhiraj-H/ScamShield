{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"vite",
 "buildCommand":"npm run build",
 "installCommand":"npm ci --ignore-scripts",
 "outputDirectory":"dist-demo",
 "git":{"deploymentEnabled":false},
 "functions":{"api/analyze.mjs":{"maxDuration":120},"api/health.mjs":{"maxDuration":15}},
 "rewrites":[{"source":"/analyze","destination":"/api/analyze"},{"source":"/health","destination":"/api/health"}],
 "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"}]}]
}
