[Unit]
Description=ScamShield consistent backup and isolated restore test
[Service]
Type=oneshot
User=scamshield
WorkingDirectory=/opt/scamshield
EnvironmentFile=/etc/scamshield/backup.conf
ExecStart=/opt/scamshield/deploy/backup-daily.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/scamshield/backups
