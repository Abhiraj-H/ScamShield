# Server runtime only; inject secrets from your vault, never commit real values.
OPENAI_MODEL=gpt-4.1-mini
# Direct OpenAI account, optional. Use OPENAI_API_KEY_FILE for the standalone API.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY_FILE=
# Required production standalone identity provider configuration.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=roles
# Signed access tokens must contain amr:["mfa"], or this exact configured acr.
OIDC_MFA_ACR=
SCAMSHIELD_AUDIT_KEY=
SCAMSHIELD_AUDIT_KEY_FILE=
SCAMSHIELD_DB=./backend/scamshield.sqlite3
SCAMSHIELD_ALLOWED_ORIGINS=
SCAMSHIELD_RATE_LIMIT=60
SCAMSHIELD_WRITE_LIMIT=12
# Loopback development only. Leave disabled on every deployed service.
SCAMSHIELD_DEV_AUTH=0
